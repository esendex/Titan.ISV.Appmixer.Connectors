{
    "name": "appmixer.esendex.core.FindTemplates",
    "label": "Find Templates",
    "description": "Search the message templates available in your Esendex account based on the specified filters. Template IDs can be used when sending or scheduling messages. This component returns a maximum of 1000 records.",
    "author": "Yanis Benhalima <yanis.benhalima@commify.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "search": {
                        "type": "string"
                    },
                    "createdStartDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdEndDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "search": {
                        "type": "text",
                        "index": 1,
                        "label": "Search",
                        "tooltip": "Only return templates matching this search text."
                    },
                    "createdStartDate": {
                        "type": "date-time",
                        "index": 2,
                        "label": "Created after",
                        "config": {
                            "enableTime": true,
                            "enableSeconds": true
                        },
                        "tooltip": "Only return templates created at or after this date."
                    },
                    "createdEndDate": {
                        "type": "date-time",
                        "index": 3,
                        "label": "Created before",
                        "config": {
                            "enableTime": true,
                            "enableSeconds": true
                        },
                        "tooltip": "Only return templates created at or before this date."
                    },
                    "sortBy": {
                        "type": "select",
                        "index": 4,
                        "label": "Sort by",
                        "options": [
                            {
                                "content": "Default",
                                "value": ""
                            },
                            {
                                "content": "Name",
                                "value": "name"
                            },
                            {
                                "content": "Created at",
                                "value": "createdAt"
                            }
                        ],
                        "tooltip": "Field used to sort the results."
                    },
                    "sortOrder": {
                        "type": "select",
                        "index": 5,
                        "label": "Sort order",
                        "options": [
                            {
                                "content": "Default (descending)",
                                "value": ""
                            },
                            {
                                "content": "Ascending",
                                "value": "Asc"
                            },
                            {
                                "content": "Descending",
                                "value": "Desc"
                            }
                        ],
                        "tooltip": "Sorting direction. The API defaults to descending."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/esendex/core/FindTemplates?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
