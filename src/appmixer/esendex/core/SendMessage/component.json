{
    "name": "appmixer.esendex.core.SendMessage",
    "label": "Send Message",
    "description": "Send an SMS message via the Esendex Messaging API.",
    "author": "Yanis Benhalima <yanis.benhalima@commify.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "from": { "type": "string" },
                    "messageText": { "type": "string" },
                    "templateId": { "type": "string" },
                    "shortenUrlBrand": { "type": "string" },
                    "recipients": { "type": "string" },
                    "contactIds": { "type": "string" },
                    "groupIds": { "type": "string" },
                    "name": { "type": "string" },
                    "characterSet": { "type": "string", "enum": ["Auto", "GSM", "Unicode"] },
                    "messageType": {
                        "type": "string",
                        "enum": [
                            "MarketingAndResearch",
                            "NotificationsAndReminders",
                            "AuthenticationAndSecurity",
                            "PaymentsAndCollections",
                            "InternalOperations",
                            "CustomerSupport",
                            "Conversational"
                        ]
                    },
                    "validity": { "type": "string", "format": "date-time" },
                    "attachmentUrl": { "type": "string" },
                    "attachmentFileName": { "type": "string" },
                    "attachmentDescription": { "type": "string" },
                    "metaData": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "from": {
                        "type": "text",
                        "label": "From (sender ID)",
                        "group": "message",
                        "index": 1,
                        "tooltip": "Originator: an alphanumeric sender ID, or a numeric VMN/shortcode you own. Required unless a default sender ID is set on your Esendex account."
                    },
                    "messageText": {
                        "type": "textarea",
                        "label": "Message text",
                        "group": "message",
                        "index": 2,
                        "tooltip": "The message content. Provide either this OR a Template ID. Embed [shorten:http://your/url] to auto-shorten a URL."
                    },
                    "templateId": {
                        "type": "text",
                        "label": "Template ID",
                        "group": "message",
                        "index": 3,
                        "tooltip": "GUID of an Esendex template. Provide either this OR Message text.",
                        "source": {
                          "url": "/component/appmixer/esendex/core/FindTemplates?outPort=out",
                          "data": {
                            "properties": { "isSource": true },
                            "messages": { "in/outputType": "array" },
                            "transform": "./FindTemplates#toSelectArray"

                          }
                        }
                    },
                    "shortenUrlBrand": {
                        "type": "text",
                        "label": "Shorten URL brand",
                        "group": "message",
                        "index": 4,
                        "tooltip": "Optional branded domain to use for shortened URLs."
                    },
                    "recipients": {
                        "type": "textarea",
                        "label": "Recipient numbers",
                        "group": "recipients",
                        "index": 1,
                        "tooltip": "Phone numbers in international format (e.g. +447700900123), one per line or comma-separated. Use this and/or contact/group IDs."
                    },
                    "contactIds": {
                        "type": "textarea",
                        "label": "Address book contact IDs",
                        "group": "recipients",
                        "index": 2,
                        "tooltip": "Esendex contact IDs (GUIDs), one per line or comma-separated."
                    },
                    "groupIds": {
                        "type": "textarea",
                        "label": "Address book group IDs",
                        "group": "recipients",
                        "index": 3,
                        "tooltip": "Esendex group IDs (GUIDs), one per line or comma-separated."
                    },
                    "name": {
                        "type": "text",
                        "label": "Request name",
                        "group": "options",
                        "index": 1,
                        "tooltip": "Optional friendly name shown in message-history exports."
                    },
                    "characterSet": {
                        "type": "select",
                        "label": "Character set",
                        "group": "options",
                        "index": 2,
                        "options": [
                            { "content": "Auto", "value": "Auto" },
                            { "content": "GSM", "value": "GSM" },
                            { "content": "Unicode", "value": "Unicode" }
                        ],
                        "tooltip": "Auto (default) detects Unicode and falls back to GSM. GSM ~140 chars/part; Unicode ~70 chars/part."
                    },
                    "messageType": {
                        "type": "select",
                        "label": "Message type",
                        "group": "options",
                        "index": 3,
                        "options": [
                            { "content": "Marketing and research", "value": "MarketingAndResearch" },
                            { "content": "Notifications and reminders", "value": "NotificationsAndReminders" },
                            { "content": "Authentication and security", "value": "AuthenticationAndSecurity" },
                            { "content": "Payments and collections", "value": "PaymentsAndCollections" },
                            { "content": "Internal operations", "value": "InternalOperations" },
                            { "content": "Customer support", "value": "CustomerSupport" },
                            { "content": "Conversational", "value": "Conversational" }
                        ],
                        "tooltip": "Helps Esendex reporting classify the message."
                    },
                    "validity": {
                        "type": "date-time",
                        "label": "Validity",
                        "group": "options",
                        "index": 4,
                        "config": { "enableTime": true, "enableSeconds": true },
                        "tooltip": "Message retry deadline. Must be >1 minute and <72 hours in the future. Defaults to 72 hours."
                    },
                    "attachmentUrl": {
                        "type": "text",
                        "label": "Attachment URL",
                        "group": "options",
                        "index": 5,
                        "tooltip": "Optional URL of a file to attach to the message."
                    },
                    "attachmentFileName": {
                        "type": "text",
                        "label": "Attachment file name",
                        "group": "options",
                        "index": 6
                    },
                    "attachmentDescription": {
                        "type": "text",
                        "label": "Attachment description",
                        "group": "options",
                        "index": 7
                    },
                    "metaData": {
                        "type": "textarea",
                        "label": "Metadata (JSON)",
                        "group": "options",
                        "index": 8,
                        "tooltip": "Optional JSON object of key/value pairs saved with the message, e.g. {\"orderId\": \"123\"}."
                    }
                },
                "groups": {
                    "message": { "label": "Message", "index": 1 },
                    "recipients": { "label": "Recipients", "index": 2 },
                    "options": { "label": "Advanced options", "index": 3 }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "requestId": {
                        "type": "string",
                        "title": "Request ID",
                        "example": "8dcad127-bb9c-48fe-9827-db2fe57d53fb"
                    },
                    "messageIds": {
                        "type": "array",
                        "title": "Message IDs",
                        "items": { "type": "string" },
                        "example": ["0929df71-d1ea-4b02-87b2-9789b332a92e"]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
