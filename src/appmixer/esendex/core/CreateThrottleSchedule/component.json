{
    "name": "appmixer.esendex.core.CreateThrottleSchedule",
    "label": "Create Throttle Schedule",
    "description": "Create a throttled batch message schedule: send a large SMS batch at a fixed hourly rate, or spread it evenly across a start/end date window.",
    "author": "Yanis Benhalima <yanis.benhalima@commify.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "scheduleType": {
                        "type": "string",
                        "enum": [
                            "rate",
                            "period"
                        ]
                    },
                    "startDate": {
                        "type": "string"
                    },
                    "timeSlotStart": {
                        "type": "string"
                    },
                    "rateOfSend": {
                        "type": [
                            "number",
                            "string"
                        ]
                    },
                    "endDate": {
                        "type": "string"
                    },
                    "timeSlotEnd": {
                        "type": "string"
                    },
                    "daysOfWeek": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "from": {
                        "type": "string"
                    },
                    "messageText": {
                        "type": "string"
                    },
                    "recipients": {
                        "type": "string"
                    },
                    "contactIds": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "characterSet": {
                        "type": "string",
                        "enum": [
                            "Auto",
                            "GSM",
                            "Unicode"
                        ]
                    },
                    "messageType": {
                        "type": "string",
                        "enum": [
                            "MarketingAndResearch",
                            "NotificationsAndReminders",
                            "AuthenticationAndSecurity",
                            "PaymentsAndCollections",
                            "InternalOperations",
                            "CustomerSupport",
                            "Conversational"
                        ]
                    },
                    "metaData": {
                        "type": "string"
                    }
                },
                "required": [
                    "scheduleType",
                    "startDate",
                    "timeSlotStart",
                    "messageText"
                ],
                "if": {
                    "properties": {
                        "scheduleType": {
                            "const": "period"
                        }
                    }
                },
                "then": {
                    "required": [
                        "endDate",
                        "timeSlotEnd"
                    ]
                },
                "else": {
                    "required": [
                        "rateOfSend"
                    ]
                }
            },
            "inspector": {
                "inputs": {
                    "scheduleType": {
                        "type": "select",
                        "label": "Schedule type",
                        "group": "schedule",
                        "index": 1,
                        "required": true,
                        "defaultValue": "rate",
                        "options": [
                            {
                                "content": "Rate-based (messages per hour)",
                                "value": "rate"
                            },
                            {
                                "content": "Period-based (finish by an end date)",
                                "value": "period"
                            }
                        ],
                        "tooltip": "Rate-based: you set how many messages are sent per hour and the platform estimates the end date. Period-based: you set the end date/time and the platform derives the optimal rate."
                    },
                    "startDate": {
                        "type": "date-time",
                        "label": "Start date",
                        "group": "schedule",
                        "index": 2,
                        "required": true,
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "The day the schedule starts sending, at most 365 days in the future. All schedule dates and times are UTC."
                    },
                    "timeSlotStart": {
                        "type": "text",
                        "label": "Time slot start",
                        "group": "schedule",
                        "index": 3,
                        "required": true,
                        "tooltip": "The time of day sending starts, in HH:MM:SS 24-hour UTC format, e.g. 15:30:00."
                    },
                    "rateOfSend": {
                        "type": "number",
                        "label": "Rate of send",
                        "group": "schedule",
                        "index": 4,
                        "required": true,
                        "when": {
                            "eq": {
                                "./scheduleType": "rate"
                            }
                        },
                        "tooltip": "The number of messages to send per hour. Required for a rate-based schedule; the platform estimates the end date from this rate."
                    },
                    "endDate": {
                        "type": "date-time",
                        "label": "End date",
                        "group": "schedule",
                        "index": 5,
                        "required": true,
                        "when": {
                            "eq": {
                                "./scheduleType": "period"
                            }
                        },
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "The day all messages must be sent by. Required for a period-based schedule."
                    },
                    "timeSlotEnd": {
                        "type": "text",
                        "label": "Time slot end",
                        "group": "schedule",
                        "index": 6,
                        "required": true,
                        "when": {
                            "eq": {
                                "./scheduleType": "period"
                            }
                        },
                        "tooltip": "The time of day sending stops, in HH:MM:SS 24-hour UTC format, e.g. 16:30:00. Required for a period-based schedule."
                    },
                    "daysOfWeek": {
                        "type": "multiselect",
                        "label": "Days of week",
                        "group": "schedule",
                        "index": 7,
                        "options": [
                            {
                                "label": "Monday",
                                "value": "Monday"
                            },
                            {
                                "label": "Tuesday",
                                "value": "Tuesday"
                            },
                            {
                                "label": "Wednesday",
                                "value": "Wednesday"
                            },
                            {
                                "label": "Thursday",
                                "value": "Thursday"
                            },
                            {
                                "label": "Friday",
                                "value": "Friday"
                            },
                            {
                                "label": "Saturday",
                                "value": "Saturday"
                            },
                            {
                                "label": "Sunday",
                                "value": "Sunday"
                            }
                        ],
                        "tooltip": "Optional: only send on these days of the week. Leave empty to allow any day."
                    },
                    "from": {
                        "type": "text",
                        "label": "From (sender ID)",
                        "group": "message",
                        "index": 1,
                        "tooltip": "Originator: an alphanumeric sender ID, or a numeric VMN/shortcode you own. Required unless a default sender ID is set on your Esendex account."
                    },
                    "messageText": {
                        "type": "textarea",
                        "label": "Message text",
                        "group": "message",
                        "index": 2,
                        "required": true,
                        "tooltip": "The message content sent to every recipient. Embed [shorten:http://your/url] to auto-shorten a URL (full accounts only)."
                    },
                    "recipients": {
                        "type": "textarea",
                        "label": "Recipient numbers",
                        "group": "recipients",
                        "index": 1,
                        "tooltip": "Phone numbers in international format (e.g. +447700900123), one per line or comma-separated. Use this and/or contact IDs."
                    },
                    "contactIds": {
                        "type": "textarea",
                        "label": "Address book contact IDs",
                        "group": "recipients",
                        "index": 2,
                        "tooltip": "Esendex contact IDs (GUIDs), one per line or comma-separated. Max 50,000 contacts per request."
                    },
                    "name": {
                        "type": "text",
                        "label": "Request name",
                        "group": "options",
                        "index": 1,
                        "tooltip": "Optional friendly name shown in message-history exports."
                    },
                    "characterSet": {
                        "type": "select",
                        "label": "Character set",
                        "group": "options",
                        "index": 2,
                        "options": [
                            {
                                "content": "Auto",
                                "value": "Auto"
                            },
                            {
                                "content": "GSM",
                                "value": "GSM"
                            },
                            {
                                "content": "Unicode",
                                "value": "Unicode"
                            }
                        ],
                        "tooltip": "Auto (default) detects Unicode and falls back to GSM. GSM ~140 chars/part; Unicode ~70 chars/part."
                    },
                    "messageType": {
                        "type": "select",
                        "label": "Message type",
                        "group": "options",
                        "index": 3,
                        "options": [
                            {
                                "content": "Marketing and research",
                                "value": "MarketingAndResearch"
                            },
                            {
                                "content": "Notifications and reminders",
                                "value": "NotificationsAndReminders"
                            },
                            {
                                "content": "Authentication and security",
                                "value": "AuthenticationAndSecurity"
                            },
                            {
                                "content": "Payments and collections",
                                "value": "PaymentsAndCollections"
                            },
                            {
                                "content": "Internal operations",
                                "value": "InternalOperations"
                            },
                            {
                                "content": "Customer support",
                                "value": "CustomerSupport"
                            },
                            {
                                "content": "Conversational",
                                "value": "Conversational"
                            }
                        ],
                        "tooltip": "Helps Esendex reporting classify the message."
                    },
                    "metaData": {
                        "type": "textarea",
                        "label": "Metadata (JSON)",
                        "group": "options",
                        "index": 4,
                        "tooltip": "Optional JSON object of key/value pairs saved with the request, e.g. {\"campaignId\": \"123\"}."
                    }
                },
                "groups": {
                    "schedule": {
                        "label": "Schedule",
                        "index": 1
                    },
                    "message": {
                        "label": "Message",
                        "index": 2
                    },
                    "recipients": {
                        "label": "Recipients",
                        "index": 3
                    },
                    "options": {
                        "label": "Advanced options",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "throttleScheduleId": {
                        "type": "string",
                        "title": "Throttle Schedule ID",
                        "example": "9ecac452-f585-4b1f-be45-7657a8583521"
                    },
                    "estimatedEndDateTime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Estimated End Date Time",
                        "example": "2025-07-10T15:51:00.0000000Z"
                    },
                    "numberOfRecipients": {
                        "type": "integer",
                        "title": "Number Of Recipients",
                        "example": 1
                    },
                    "estimatedRateOfSend": {
                        "type": "integer",
                        "title": "Estimated Rate Of Send",
                        "example": 50
                    },
                    "billingDetails": {
                        "type": "object",
                        "title": "Billing Details",
                        "properties": {
                            "projectedBalance": {
                                "type": "number",
                                "title": "Projected Balance",
                                "example": 4.75
                            },
                            "currency": {
                                "type": "string",
                                "title": "Currency",
                                "example": "EUR"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/png;base64,"
}
