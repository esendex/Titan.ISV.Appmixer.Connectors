{
    "name": "appmixer.esendex.core.FindMessages",
    "label": "Find Messages",
    "description": "Search the sent and received messages of your Esendex account based on the specified filters. Fires the notFound port if no message matches. Fetches pages of 1000 messages internally; 'All items at once' is limited by the engine message size, 'Store to CSV file' streams a full export, and 'One item at a time' emits every record, resuming across runs on large accounts.",
    "icon": "data:image/svg+xml;base64,",
    "author": "Yanis Benhalima <yanis.benhalima@commify.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "requestId": {
                        "type": "string"
                    },
                    "conversationId": {
                        "type": "string"
                    },
                    "msisdn": {
                        "type": "string"
                    },
                    "originator": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "direction": {
                        "type": "string"
                    },
                    "startTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "requestId": {
                        "type": "text",
                        "index": 1,
                        "label": "Request ID",
                        "tooltip": "Filter by the request ID (GUID) that was returned when the messages were sent."
                    },
                    "conversationId": {
                        "type": "text",
                        "index": 2,
                        "label": "Conversation ID",
                        "tooltip": "Filter to a conversation: all inbound and outbound messages between your account and one recipient."
                    },
                    "msisdn": {
                        "type": "text",
                        "index": 3,
                        "label": "Phone number",
                        "tooltip": "Filter by the phone number that received the outbound message or sent the inbound message. Use international format, e.g. +447700900123."
                    },
                    "originator": {
                        "type": "text",
                        "index": 4,
                        "label": "Originator",
                        "tooltip": "Filter by the 'from' value of outbound messages or the 'to' value of inbound messages, e.g. a sender ID, VMN or shortcode."
                    },
                    "status": {
                        "type": "text",
                        "index": 5,
                        "label": "Status",
                        "tooltip": "Filter by message status, e.g. Delivered, Received, Failed or In Progress."
                    },
                    "direction": {
                        "type": "select",
                        "index": 6,
                        "label": "Direction",
                        "options": [
                            {
                                "content": "All",
                                "value": ""
                            },
                            {
                                "content": "Outbound",
                                "value": "Outbound"
                            },
                            {
                                "content": "Inbound",
                                "value": "Inbound"
                            }
                        ],
                        "tooltip": "Filter by message direction."
                    },
                    "startTime": {
                        "type": "date-time",
                        "index": 7,
                        "label": "Submitted after",
                        "config": {
                            "enableTime": true,
                            "enableSeconds": true
                        },
                        "tooltip": "Only return messages submitted at or after this time."
                    },
                    "endTime": {
                        "type": "date-time",
                        "index": 8,
                        "label": "Submitted before",
                        "config": {
                            "enableTime": true,
                            "enableSeconds": true
                        },
                        "tooltip": "Only return messages submitted at or before this time."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 9,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "How the results are returned. 'All items at once' fits small result sets (limited by the engine message size); 'Store to CSV file' streams a full export of any size; 'One item at a time' emits every record and resumes across runs on large accounts; 'First item only' returns the first match.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/esendex/core/FindMessages?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ]
}
