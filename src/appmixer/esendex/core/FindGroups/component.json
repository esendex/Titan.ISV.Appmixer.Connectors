{
    "name": "appmixer.esendex.core.FindGroups",
    "label": "Find Groups",
    "description": "Find groups in your Esendex account based on the specified filters. Fires the notFound port if no group matches. Fetches pages of 1000 groups internally; 'All items at once' is limited by the engine message size, 'Store to CSV file' streams a full export, and 'One item at a time' emits every record, resuming across runs on large accounts.",
    "icon": "data:image/svg+xml;base64,",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "groupOwnership": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "type": "string"
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Filter by the name of the group"
                    },
                    "groupOwnership": {
                        "type": "select",
                        "index": 2,
                        "label": "Group Ownership",
                        "options": [
                            {
                                "content": "All",
                                "value": ""
                            },
                            {
                                "content": "Owned",
                                "value": "Owned"
                            },
                            {
                                "content": "Shared",
                                "value": "Shared"
                            }
                        ],
                        "tooltip": "Specifies the ownership type of a group to filter by."
                    },
                    "sortBy": {
                        "type": "select",
                        "index": 3,
                        "label": "Sort by",
                        "options": [
                            {
                                "content": "Default",
                                "value": ""
                            },
                            {
                                "content": "Name",
                                "value": "name"
                            },
                            {
                                "content": "Created date",
                                "value": "createdAt"
                            }
                        ],
                        "tooltip": "Sort groups."
                    },
                    "sortOrder": {
                        "type": "select",
                        "index": 4,
                        "label": "Sort order",
                        "options": [
                            {
                                "content": "Default (Descending)",
                                "value": ""
                            },
                            {
                                "content": "Ascending",
                                "value": "Asc"
                            },
                            {
                                "content": "Descending",
                                "value": "Desc"
                            }
                        ],
                        "tooltip": "Sets the sorting direction."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 5,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "How the results are returned. 'All items at once' fits small result sets (limited by the engine message size); 'Store to CSV file' streams a full export of any size; 'One item at a time' emits every record and resumes across runs on large accounts; 'First item only' returns the first match.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/esendex/core/FindGroups?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ]
}
