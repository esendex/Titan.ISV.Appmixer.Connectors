{
    "name": "appmixer.esendex.core.FindContacts",
    "label": "Find Contacts",
    "description": "Find contacts in your Esendex account based on the specified filters. Fires the notFound port if no contact matches. Fetches pages of 1000 contacts internally; 'All items at once' is limited by the engine message size, 'Store to CSV file' streams a full export, and 'One item at a time' emits every record, resuming across runs on large accounts.",
    "icon": "data:image/svg+xml;base64,",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:esendex"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "search": {
                        "type": "string"
                    },
                    "groupId": {
                        "type": "string"
                    },
                    "destination": {
                        "type": "string"
                    },
                    "optOutStatus": {
                        "type": "string"
                    },
                    "contactOwnership": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "type": "string"
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "search": {
                        "type": "text",
                        "index": 1,
                        "label": "Search",
                        "tooltip": "Ability to search using the following: address | first name | last name | quick name. Searching will retrieve information from all parameters"
                    },
                    "groupId": {
                        "type": "text",
                        "index": 2,
                        "label": "Group ID",
                        "tooltip": "Filter contacts by a certain groupId only"
                    },
                    "destination": {
                        "type": "text",
                        "index": 3,
                        "label": "Destination",
                        "tooltip": "Filter contacts by the destination. Value should be a valid ISO3166 country code. For example: GB | DE | IT | US"
                    },
                    "optOutStatus": {
                        "type": "select",
                        "index": 4,
                        "label": "Opt-Out Status",
                        "options": [
                            {
                                "content": "All",
                                "value": ""
                            },
                            {
                                "content": "Subscribed",
                                "value": "subscribed"
                            },
                            {
                                "content": "Unsubscribed",
                                "value": "unsubscribed"
                            }
                        ],
                        "tooltip": "Filter contacts by the optOutStatus."
                    },
                    "contactOwnership": {
                        "type": "select",
                        "index": 5,
                        "label": "Contact Ownership",
                        "options": [
                            {
                                "content": "All",
                                "value": ""
                            },
                            {
                                "content": "Owned",
                                "value": "Owned"
                            },
                            {
                                "content": "Shared",
                                "value": "Shared"
                            }
                        ],
                        "tooltip": "Specifies the ownership type of a contact to filter by."
                    },
                    "sortBy": {
                        "type": "select",
                        "index": 6,
                        "label": "Sort by",
                        "options": [
                            {
                                "content": "Default",
                                "value": ""
                            },
                            {
                                "content": "Name",
                                "value": "Name"
                            },
                            {
                                "content": "Created date",
                                "value": "createdAt"
                            }
                        ],
                        "tooltip": "Sort contacts into grouped data."
                    },
                    "sortOrder": {
                        "type": "select",
                        "index": 7,
                        "label": "Sort order",
                        "options": [
                            {
                                "content": "Default (Descending)",
                                "value": ""
                            },
                            {
                                "content": "Ascending",
                                "value": "Asc"
                            },
                            {
                                "content": "Descending",
                                "value": "Desc"
                            }
                        ],
                        "tooltip": "Sets the sorting direction."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 8,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "How the results are returned. 'All items at once' fits small result sets (limited by the engine message size); 'Store to CSV file' streams a full export of any size; 'One item at a time' emits every record and resumes across runs on large accounts; 'First item only' returns the first match.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/esendex/core/FindContacts?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ]
}
