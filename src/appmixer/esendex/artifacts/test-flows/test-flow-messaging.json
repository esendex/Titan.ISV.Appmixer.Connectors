{
    "name": "E2E Esendex - messaging",
    "description": "End-to-end test for the Esendex connector - sends an SMS via SendMessage, reads the message history via MakeApiCall (GET /v2/messages) and searches it via FindMessages. Covers all components of the connector.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {},
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "recipientNumber",
                                                "text": "+447700900123"
                                            },
                                            {
                                                "type": "text",
                                                "name": "messageText",
                                                "text": "E2E Esendex test message"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "send-message": {
            "type": "appmixer.esendex.core.SendMessage",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "messageText": {
                                        "var-message-text": {
                                            "variable": "$.set-variables.out.messageText",
                                            "functions": []
                                        }
                                    },
                                    "recipients": {
                                        "var-recipient": {
                                            "variable": "$.set-variables.out.recipientNumber",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "messageText": "{{{var-message-text}}}",
                                    "recipients": "{{{var-recipient}}}"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "assert-send": {
            "type": "appmixer.utils.test.Assert",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-message": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-message": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-request-id": {
                                            "variable": "$.send-message.out.requestId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-request-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "make-api-call": {
            "type": "appmixer.esendex.core.MakeApiCall",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-message": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-message": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {},
                                "lambda": {
                                    "url": "/v2/messages?pageSize=1",
                                    "method": "GET"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "assert-api-call": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "make-api-call": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "make-api-call": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-status": {
                                            "variable": "$.make-api-call.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-status}}}",
                                                "assertion": "equal",
                                                "expected": "200"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "find-messages": {
            "type": "appmixer.esendex.core.FindMessages",
            "x": 640,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-message": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-message": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {},
                                "lambda": {
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "assert-find": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-messages": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-messages": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-result": {
                                            "variable": "$.find-messages.out.result",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-result}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-send": [
                        "out"
                    ],
                    "assert-api-call": [
                        "out"
                    ],
                    "assert-find": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 120
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "6a7f29eeff46475feb6734f5",
                    "failedStoreId": "6a7f29ee62f8490f6b01bf56"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Esendex - messaging",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        }
    }
}
