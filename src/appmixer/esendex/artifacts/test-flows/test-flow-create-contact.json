{
    "name": "E2E Esendex - create contact",
    "description": "End-to-end test for the Esendex connector - creates a contact with a unique run-stamped last name via CreateContact and asserts the returned contactId. Note: there is no DeleteContact component yet, so created 'E2E' contacts accumulate on the test account (findable via FindContacts search 'E2E').",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {},
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "create-contact": {
            "type": "appmixer.esendex.core.CreateContact",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "lastName": {
                                        "ts-var": {
                                            "variable": "$.on-start.out.started",
                                            "functions": [
                                                {
                                                    "name": "g_timestamp"
                                                }
                                            ]
                                        }
                                    }
                                },
                                "lambda": {
                                    "firstName": "E2E",
                                    "lastName": "Contact-{{{ts-var}}}"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-id": {
                                            "variable": "$.create-contact.out.contactId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 120
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "6a7f29eeff46475feb6734f5",
                    "failedStoreId": "6a7f29ee62f8490f6b01bf56"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Esendex - create contact",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        }
    }
}
